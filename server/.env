# Server Configuration
# PORT_SERVER and PORT_DB are currently hardcoded in server.js but are typically placed here.

# Authentication
# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_ACCESS_SECRET=your_jwt_access_secret_here

# AI Processing (Gemini API)
# Required for generating embeddings (tabProcessor.js) and semantic topics (clusteringCron.js)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (BullMQ workers)
# Make sure your local Redis instance or Docker container is running on this port
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
